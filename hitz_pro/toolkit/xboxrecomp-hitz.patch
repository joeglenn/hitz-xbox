+         * window block covers the page (see bus_resolve_desc). */
+        extern int xbox_PhysImageNamed(uint32_t);
+        extern const volatile uint8_t *xbox_ContiguousPageMap(void);
+        const volatile uint8_t *map = xbox_ContiguousPageMap();
