diff --git a/src/platform/perf_log.h b/src/platform/perf_log.h
new file mode 100644
index 0000000..6208779
--- /dev/null
+++ b/src/platform/perf_log.h
@@ -0,0 +1,86 @@
+/*
+ * perf_log.h - a human-readable timing log for chasing stutter.
+ *
+ * One file (RECOMP_PERF_LOG_FILE, default "perf.log" in the working
+ * directory), written only when RECOMP_PERF_LOG=1. It answers "why did that
+ * moment feel laggy" after the fact:
+ *
+ *   - a header with the machine, the display and the settings in effect;
+ *   - a HITCH line for every game frame that took clearly longer than the
+ *     ones around it, with what happened during it (shaders compiled,
+ *     textures uploaded, game files opened);
+ *   - a JUDDER line when the presenter saw a frame stay on screen for a
+ *     different number of display refreshes than the steady cadence;
+ *   - a summary every 5 s (frame rate, frame-time range, display rate and
+ *     pacing state);
+ *   - a MARK line each time the player presses F9, so "it stuttered just
+ *     now" can be found in the file by its wall-clock time.
+ *
+ * Every call is cheap and thread-safe; all of them do nothing while the log
+ * is off. Each line is flushed as it is written, so a crash keeps the tail.
+ */
+#ifndef XBOX_PERF_LOG_H
+#define XBOX_PERF_LOG_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Per-frame counters, reset at each game frame (xbox_PerfFlip). */
+enum {
+    XBOX_PERF_SHADERS = 0,      /* shaders compiled on the render thread */
+    XBOX_PERF_SHADER_MS,        /* ... and the milliseconds that took */
+    XBOX_PERF_SHADERS_ASYNC,    /* shaders handed to the background compiler */
+    XBOX_PERF_TEXTURES,         /* textures uploaded */
+    XBOX_PERF_TEX_BYTES,        /* ... and their size */
+    /* Where a frame's time went, in milliseconds. */
+    XBOX_PERF_TEX_MS,           /* converting + uploading new textures */
+    XBOX_PERF_HASH_MS,          /* checking cached textures for changes */
+    XBOX_PERF_DRAW_MS,          /* building draws (CPU side) */
+    XBOX_PERF_FLUSH_MS,         /* submitting to the GPU + reading frames back */
+    XBOX_PERF_KERNEL_MS,        /* kernel calls over 0.5 ms (files, memory...) */
+    XBOX_PERF_COUNTERS
+};
+
+/* Opens RECOMP_PERF_LOG_FILE and writes the header if RECOMP_PERF_LOG=1;
+ * a no-op (the log stays off) otherwise. Safe to call more than once: only
+ * the first call decides. Called lazily by xbox_PerfEnabled, so nothing
+ * needs to call it explicitly before logging. */
+void xbox_PerfInit(void);
+/* Whether the log is open. Also the gate every other xbox_Perf* call checks
+ * first, so callers never need to test RECOMP_PERF_LOG themselves. */
+int  xbox_PerfEnabled(void);
+/* A free-form line, prefixed with the time. */
+void xbox_PerfNote(const char *fmt, ...);
+/* Adds to a per-frame counter (see the XBOX_PERF_* enum); folded into the
+ * HITCH line and the 5 s summary at the next xbox_PerfFlip. */
+void xbox_PerfCount(int counter, double amount);
+/* A game file was opened (shown on a hitch that happened during it). */
+void xbox_PerfFile(const char *path);
+/* The title flipped: one game frame ended. Computes the frame's duration
+ * from the previous flip, decides whether it was a hitch, and resets the
+ * per-frame counters and file list for the next frame. */
+void xbox_PerfFlip(void);
+/* The presenter's view: the previous frame stayed on screen for `refreshes`
+ * display refreshes; `expected` is the steady value (0 when there is none,
+ * e.g. a 144 Hz display showing 60 fps). */
+void xbox_PerfShown(uint32_t refreshes, uint32_t expected);
+/* Display state, for the summaries: refresh rate, whether the game's frame
+ * clock is locked to it (and every how many refreshes), the lock's phase
+ * error, and a short description of the presenter. */
+void xbox_PerfDisplay(double hz, int locked, int every, double phase_err_ms,
+                      const char *presenter);
+/* F9: returns the mark's number (shown in the window title), 0 when off. */
+int  xbox_PerfMark(void);
+/* Writes the final summary and an "end" line, then closes the log. `why` is
+ * the reason shown on that line (e.g. "exit", a crash). Safe to call once
+ * the log was never opened (does nothing). */
+void xbox_PerfShutdown(const char *why);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
