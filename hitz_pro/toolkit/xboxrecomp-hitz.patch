+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_HIGHEST);
+    while (s_clock_run) {
+        DWORD now_tick = GetTickCount();
+        uint64_t t;
+        if (!out || (int)(now_tick - next_output) >= 0) {
+            /* Again every 2 s: the window may have moved to another monitor
+             * or the mode changed. */
+            IDXGIOutput *o2 = output_for_window();
+            if (out) IDXGIOutput_Release(out);
+            out = o2;
+            next_output = now_tick + 2000;
+            if (!est) {
+                double hz = reported_hz();
+                if (hz > 0) est = 1e9 / hz;
+            }
+        }
+        if (!out || FAILED(IDXGIOutput_WaitForVBlank(out))) {
+            Sleep(16);
+            last = 0;
+            good = 0;
+            continue;
