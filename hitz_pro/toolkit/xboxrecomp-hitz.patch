diff --git a/src/input/sdl_pads_win.c b/src/input/sdl_pads_win.c
new file mode 100644
index 0000000..97bca51
--- /dev/null
+++ b/src/input/sdl_pads_win.c
@@ -0,0 +1,449 @@
+/*
+ * sdl_pads_win.c - see sdl_pads_win.h.
+ *
+ * SDL2 is bound at run time with GetProcAddress, so neither its headers nor
+ * an import library are needed to build, and a missing SDL2.dll only costs
+ * the non-Xbox pads. The few SDL2 types and constants used are declared here;
+ * they are SDL2's stable ABI (SDL_gamecontroller.h, SDL_joystick.h).
+ */
+#if defined(_WIN32)
+#include <windows.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "sdl_pads_win.h"
+#include "perf_log.h"
+
+/* ---- the SDL2 ABI subset ---- */
+typedef struct SDL_GameController SDL_GameController;
+typedef struct SDL_Joystick SDL_Joystick;
+typedef struct { unsigned char major, minor, patch; } SDL_version;
+
+#define SDL_INIT_JOYSTICK       0x00000200u
+#define SDL_INIT_GAMECONTROLLER 0x00002000u
+enum { B_A, B_B, B_X, B_Y, B_BACK, B_GUIDE, B_START, B_LSTICK, B_RSTICK,
+       B_LSHOULDER, B_RSHOULDER, B_UP, B_DOWN, B_LEFT, B_RIGHT };
+enum { A_LX, A_LY, A_RX, A_RY, A_LT, A_RT };
+enum { T_UNKNOWN, T_XBOX360, T_XBOXONE, T_PS3, T_PS4, T_SWITCH_PRO, T_VIRTUAL, T_PS5,
+       T_LUNA, T_STADIA, T_SHIELD, T_JOYCON_L, T_JOYCON_R, T_JOYCON_PAIR };
+
+static struct {
+    int         (*Init)(unsigned);
+    const char *(*GetError)(void);
+    int         (*SetHint)(const char *, const char *);
+    void        (*GetVersion)(SDL_version *);
+    void        (*PumpEvents)(void);
+    void        (*FlushEvents)(unsigned, unsigned);
+    int         (*NumJoysticks)(void);
+    int         (*IsGameController)(int);
+    int         (*JoystickGetDeviceInstanceID)(int);
+    const char *(*JoystickNameForIndex)(int);
+    SDL_GameController *(*GameControllerOpen)(int);
+    void        (*GameControllerClose)(SDL_GameController *);
+    int         (*GameControllerGetAttached)(SDL_GameController *);
+    unsigned char (*GameControllerGetButton)(SDL_GameController *, int);
+    short       (*GameControllerGetAxis)(SDL_GameController *, int);
+    const char *(*GameControllerName)(SDL_GameController *);
+    int         (*GameControllerGetType)(SDL_GameController *);
+    int         (*GameControllerRumble)(SDL_GameController *, unsigned short, unsigned short, unsigned);
+} S;
+
+typedef struct {
+    int                 used, id, ignored;   /* ignored: an Xbox pad, XInput's */
+    SDL_GameController *c;
+    SdlPadInfo          info;
+    XBOX_INPUT_STATE    st;
+    unsigned short      rumble_lo, rumble_hi, rumble_sent_lo, rumble_sent_hi;
+    DWORD               rumble_at;
+    unsigned            order;               /* connection order */
+} Pad;
+
+static Pad              s_pad[16];           /* more than SDLPADS_MAX: ignored ones too */
+static SRWLOCK          s_lock = SRWLOCK_INIT;
+static volatile LONG    s_started;           /* 0 no, 1 starting, 2 up, -1 failed */
+static unsigned         s_order;
+static HANDLE           s_ready;
+
+/* Short controller family name for the connected-pad log/notes, from SDL's
+ * SDL_GameControllerType enum value. */
+static const char *kind_name(int t)
+{
+    switch (t) {
+    case T_PS3: return "PS3";
+    case T_PS4: return "PS4";
+    case T_PS5: return "PS5";
+    case T_SWITCH_PRO: return "Switch Pro";
+    case T_JOYCON_L: case T_JOYCON_R: case T_JOYCON_PAIR: return "Joy-Con";
+    case T_VIRTUAL: return "virtual";
+    case T_LUNA: return "Luna";
+    case T_STADIA: return "Stadia";
+    case T_SHIELD: return "Shield";
+    case T_XBOX360: case T_XBOXONE: return "Xbox";
+    default: return "generic";
+    }
+}
+
+/* Binds SDL2.dll's exported functions into S by name; called once from
+ * pad_thread before SDL_Init. Looks next to the exe first so a copy bundled
+ * with the game wins over one elsewhere on the search path, falling back to
+ * the normal DLL search. Returns 0 (no non-Xbox pads) if the DLL or any of
+ * the symbols it needs are missing; logs which symbol on failure. */
+static int load_sdl(void)
+{
+    HMODULE m;
+    wchar_t path[MAX_PATH], *slash;
+    DWORD n = GetModuleFileNameW(NULL, path, MAX_PATH);
+    /* Next to the exe first, not wherever the DLL search order finds one. */
+    if (n && n < MAX_PATH && (slash = wcsrchr(path, L'\\')) != NULL) {
+        wcscpy_s(slash + 1, MAX_PATH - (slash + 1 - path), L"SDL2.dll");
+        m = LoadLibraryW(path);
+    } else {
+        m = NULL;
+    }
+    if (!m)
+        m = LoadLibraryW(L"SDL2.dll");
+    if (!m)
+        return 0;
+#define BIND(field, sym) do { *(FARPROC *)&S.field = GetProcAddress(m, sym); \
+                              if (!S.field) { fprintf(stderr, "[PAD] SDL2.dll lacks %s\n", sym); return 0; } } while (0)
+    BIND(Init, "SDL_Init");
+    BIND(GetError, "SDL_GetError");
+    BIND(SetHint, "SDL_SetHint");
+    BIND(GetVersion, "SDL_GetVersion");
+    BIND(PumpEvents, "SDL_PumpEvents");
+    BIND(FlushEvents, "SDL_FlushEvents");
+    BIND(NumJoysticks, "SDL_NumJoysticks");
+    BIND(IsGameController, "SDL_IsGameController");
+    BIND(JoystickGetDeviceInstanceID, "SDL_JoystickGetDeviceInstanceID");
+    BIND(JoystickNameForIndex, "SDL_JoystickNameForIndex");
+    BIND(GameControllerOpen, "SDL_GameControllerOpen");
+    BIND(GameControllerClose, "SDL_GameControllerClose");
+    BIND(GameControllerGetAttached, "SDL_GameControllerGetAttached");
+    BIND(GameControllerGetButton, "SDL_GameControllerGetButton");
+    BIND(GameControllerGetAxis, "SDL_GameControllerGetAxis");
+    BIND(GameControllerName, "SDL_GameControllerName");
+    BIND(GameControllerGetType, "SDL_GameControllerGetType");
+    BIND(GameControllerRumble, "SDL_GameControllerRumble");
+#undef BIND
+    return 1;
+}
+
+/* Looks up a tracked slot by SDL instance id; NULL if none (caller holds or
+ * does not need s_lock, depending on context). */
+static Pad *find(int id)
+{
+    int i;
+    for (i = 0; i < (int)(sizeof s_pad / sizeof s_pad[0]); i++)
+        if (s_pad[i].used && s_pad[i].id == id)
+            return &s_pad[i];
+    return NULL;
+}
+
+/* SDL's controller state as an Xbox pad. Positional: the bottom face button
+ * is A whatever it is labelled (SDL_GAMECONTROLLER_USE_BUTTON_LABELS=0). */
+static void snapshot(Pad *p)
+{
+    SDL_GameController *c = p->c;
+    XBOX_INPUT_STATE s;
+    WORD btn = 0;
+    memset(&s, 0, sizeof s);
+    if (S.GameControllerGetButton(c, B_UP))     btn |= XBOX_GAMEPAD_DPAD_UP;
+    if (S.GameControllerGetButton(c, B_DOWN))   btn |= XBOX_GAMEPAD_DPAD_DOWN;
+    if (S.GameControllerGetButton(c, B_LEFT))   btn |= XBOX_GAMEPAD_DPAD_LEFT;
+    if (S.GameControllerGetButton(c, B_RIGHT))  btn |= XBOX_GAMEPAD_DPAD_RIGHT;
+    if (S.GameControllerGetButton(c, B_START))  btn |= XBOX_GAMEPAD_START;
+    if (S.GameControllerGetButton(c, B_BACK))   btn |= XBOX_GAMEPAD_BACK;
+    if (S.GameControllerGetButton(c, B_LSTICK)) btn |= XBOX_GAMEPAD_LEFT_THUMB;
+    if (S.GameControllerGetButton(c, B_RSTICK)) btn |= XBOX_GAMEPAD_RIGHT_THUMB;
+    s.Gamepad.wButtons = btn;
+    s.Gamepad.bAnalogButtons[XBOX_BUTTON_A] = S.GameControllerGetButton(c, B_A) ? 255 : 0;
+    s.Gamepad.bAnalogButtons[XBOX_BUTTON_B] = S.GameControllerGetButton(c, B_B) ? 255 : 0;
+    s.Gamepad.bAnalogButtons[XBOX_BUTTON_X] = S.GameControllerGetButton(c, B_X) ? 255 : 0;
+    s.Gamepad.bAnalogButtons[XBOX_BUTTON_Y] = S.GameControllerGetButton(c, B_Y) ? 255 : 0;
+    s.Gamepad.bAnalogButtons[XBOX_BUTTON_BLACK] = S.GameControllerGetButton(c, B_LSHOULDER) ? 255 : 0;
+    s.Gamepad.bAnalogButtons[XBOX_BUTTON_WHITE] = S.GameControllerGetButton(c, B_RSHOULDER) ? 255 : 0;
+    /* SDL triggers are 0..32767 */
+    s.Gamepad.bAnalogButtons[XBOX_BUTTON_LTRIGGER] = (BYTE)(S.GameControllerGetAxis(c, A_LT) >> 7);
+    s.Gamepad.bAnalogButtons[XBOX_BUTTON_RTRIGGER] = (BYTE)(S.GameControllerGetAxis(c, A_RT) >> 7);
+    /* SDL's Y axes point down, the Xbox's up; -1 - v keeps -32768 in range. */
+    s.Gamepad.sThumbLX = S.GameControllerGetAxis(c, A_LX);
+    s.Gamepad.sThumbLY = (SHORT)(-1 - S.GameControllerGetAxis(c, A_LY));
+    s.Gamepad.sThumbRX = S.GameControllerGetAxis(c, A_RX);
+    s.Gamepad.sThumbRY = (SHORT)(-1 - S.GameControllerGetAxis(c, A_RY));
+    /* The packet number moves only when something changed, as XInput's. */
+    s.dwPacketNumber = p->st.dwPacketNumber;
+    if (memcmp(&s.Gamepad, &p->st.Gamepad, sizeof s.Gamepad))
+        s.dwPacketNumber++;
+    p->st = s;
+}
+
+/* Opens every joystick SDL now lists that this module does not track yet.
+ * Runs on the SDL thread, at startup and about 4 times a second; takes
+ * s_lock while touching a slot. Pads with no SDL controller mapping, and
+ * ones SDL could not open, are recorded as ignored (not retried) and logged
+ * once. Xbox-type pads are also recorded ignored and closed again: XInput
+ * already reads them, and opening both would make one pad count as two. */
+static void scan(void)
+{
+    int n = S.NumJoysticks(), i;
+    for (i = 0; i < n; i++) {
+        int id = S.JoystickGetDeviceInstanceID(i);
+        Pad *p;
+        if (id < 0 || find(id))
+            continue;
+        AcquireSRWLockExclusive(&s_lock);
+        for (p = s_pad; p < s_pad + sizeof s_pad / sizeof s_pad[0] && p->used; p++)
+            ;
+        if (p == s_pad + sizeof s_pad / sizeof s_pad[0]) {
+            ReleaseSRWLockExclusive(&s_lock);
+            return;
+        }
+        memset(p, 0, sizeof *p);
+        p->used = 1;
+        p->id = id;
+        if (!S.IsGameController(i)) {
+            /* A joystick SDL has no controller mapping for: tell, once. */
+            const char *nm = S.JoystickNameForIndex(i);
+            p->ignored = 1;
+            ReleaseSRWLockExclusive(&s_lock);
+            fprintf(stderr, "[PAD] '%s' is not a known game controller (no mapping); ignored\n",
+                    nm ? nm : "?");
+            xbox_PerfNote("controller: '%s' not usable (SDL has no mapping for it)", nm ? nm : "?");
+            continue;
+        }
+        p->c = S.GameControllerOpen(i);
+        if (!p->c) {
+            p->ignored = 1;
+            ReleaseSRWLockExclusive(&s_lock);
+            fprintf(stderr, "[PAD] SDL could not open controller %d: %s\n", i, S.GetError());
+            continue;
+        }
+        {
+            const char *nm = S.GameControllerName(p->c);
+            int t = S.GameControllerGetType(p->c);
+            strncpy_s(p->info.name, sizeof p->info.name, nm ? nm : "controller", _TRUNCATE);
+            strncpy_s(p->info.kind, sizeof p->info.kind, kind_name(t), _TRUNCATE);
+            p->info.id = id;
+            p->order = ++s_order;
+            if (t == T_XBOX360 || t == T_XBOXONE) {
+                /* XInput reads these; opening both would make one pad two players. */
+                p->ignored = 1;
+                S.GameControllerClose(p->c);
+                p->c = NULL;
+            } else {
+                snapshot(p);
+            }
+            ReleaseSRWLockExclusive(&s_lock);
+            if (p->ignored)
+                fprintf(stderr, "[PAD] SDL sees '%s' (Xbox type): left to XInput\n", p->info.name);
+            else {
+                fprintf(stderr, "[PAD] SDL controller connected: '%s' (%s)\n", p->info.name, p->info.kind);
+                xbox_PerfNote("controller connected through SDL: '%s' (%s)", p->info.name, p->info.kind);
+            }
+        }
+    }
+}
+
+/* Refreshes every open pad's snapshot and rumble state, and drops any whose
+ * controller SDL reports detached. Runs every loop of the SDL thread. */
+static void update(void)
+{
+    int i;
+    DWORD now = GetTickCount();
+    for (i = 0; i < (int)(sizeof s_pad / sizeof s_pad[0]); i++) {
+        Pad *p = &s_pad[i];
+        if (!p->used)
+            continue;
+        if (p->c && !S.GameControllerGetAttached(p->c)) {
+            char nm[64];
+            strncpy_s(nm, sizeof nm, p->info.name, _TRUNCATE);
+            AcquireSRWLockExclusive(&s_lock);
+            S.GameControllerClose(p->c);
+            memset(p, 0, sizeof *p);
+            ReleaseSRWLockExclusive(&s_lock);
+            fprintf(stderr, "[PAD] SDL controller disconnected: '%s'\n", nm);
+            xbox_PerfNote("controller disconnected: '%s'", nm);
+            continue;
+        }
+        if (!p->c)
+            continue;
+        AcquireSRWLockExclusive(&s_lock);
+        snapshot(p);
+        /* Rumble wants a duration: re-send changes, and refresh a running
+         * motor every 500 ms (the game sets it continuously). */
+        if (p->rumble_lo != p->rumble_sent_lo || p->rumble_hi != p->rumble_sent_hi
+            || ((p->rumble_lo || p->rumble_hi) && now - p->rumble_at > 500)) {
+            S.GameControllerRumble(p->c, p->rumble_lo, p->rumble_hi, 1000);
+            p->rumble_sent_lo = p->rumble_lo;
+            p->rumble_sent_hi = p->rumble_hi;
+            p->rumble_at = now;
+        }
+        ReleaseSRWLockExclusive(&s_lock);
+    }
+}
+
+/* Drop the records of joysticks SDL no longer lists (ignored ones have no
+ * controller handle to notice it by). */
+static void forget_missing(void)
+{
+    int n = S.NumJoysticks(), i, j;
+    for (i = 0; i < (int)(sizeof s_pad / sizeof s_pad[0]); i++) {
+        int seen = 0;
+        if (!s_pad[i].used || s_pad[i].c)
+            continue;
+        for (j = 0; j < n && !seen; j++)
+            seen = S.JoystickGetDeviceInstanceID(j) == s_pad[i].id;
+        if (!seen) {
+            AcquireSRWLockExclusive(&s_lock);
+            memset(&s_pad[i], 0, sizeof s_pad[i]);
+            ReleaseSRWLockExclusive(&s_lock);
+        }
+    }
+}
+
+/* The thread that owns SDL for its whole life: sets the hints, calls
+ * SDL_Init, does the first scan, then loops pumping events, periodically
+ * rescanning for new/removed pads, and refreshing snapshots, until the
+ * process exits (there is no shutdown path). On SDL_Init failure it marks
+ * startup failed and returns so only XInput pads are seen. */
+static DWORD WINAPI pad_thread(LPVOID unused)
+{
+    SDL_version v;
+    unsigned tick = 0;
+    (void)unused;
+    /* Hints before SDL_Init. Background events: our window is not SDL's, so
+     * SDL never thinks it has focus. HIDAPI Xbox off: XInput owns Xbox pads.
+     * Raw input off: it would also claim Xbox pads. Positional buttons. */
+    S.SetHint("SDL_NO_SIGNAL_HANDLERS", "1");
+    S.SetHint("SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS", "1");
+    S.SetHint("SDL_JOYSTICK_HIDAPI_XBOX", "0");
+    S.SetHint("SDL_JOYSTICK_RAWINPUT", "0");
+    S.SetHint("SDL_GAMECONTROLLER_USE_BUTTON_LABELS", "0");
+    if (S.Init(SDL_INIT_GAMECONTROLLER | SDL_INIT_JOYSTICK) != 0) {
+        fprintf(stderr, "[PAD] SDL_Init failed: %s; only XInput controllers will work\n", S.GetError());
+        xbox_PerfNote("controllers: SDL failed to start (%s); only Xbox controllers work", S.GetError());
+        InterlockedExchange(&s_started, -1);
+        SetEvent(s_ready);
+        return 0;
+    }
+    S.GetVersion(&v);
+    fprintf(stderr, "[PAD] SDL %u.%u.%u up: non-Xbox controllers supported\n", v.major, v.minor, v.patch);
+    xbox_PerfNote("controllers: XInput + SDL %u.%u.%u", v.major, v.minor, v.patch);
+    S.PumpEvents();
+    scan();
+    InterlockedExchange(&s_started, 2);
+    SetEvent(s_ready);
+    for (;;) {
+        /* Pumping runs SDL's device detection and its helper window's
+         * messages (this thread created it); the event queue itself is not
+         * read, so it is emptied to stay small. */
+        S.PumpEvents();
+        S.FlushEvents(0, 0xFFFF);
+        if ((tick++ & 63) == 0) {          /* about 4 times a second */
+            scan();
+            forget_missing();
+        }
+        update();
+        Sleep(4);
+    }
+}
+
+/* Starts the SDL pad thread the first time it is called; later calls just
+ * report whether it is up. Honours RECOMP_SDL_PADS=0 (XInput only) and does
+ * nothing if SDL2.dll cannot be loaded. Blocks up to 3 s for the thread's
+ * first scan to finish, so pads already plugged in are visible to the
+ * caller's first read. Called from xinput_device.c's port scanner. */
+int sdlpads_start(void)
+{
+    const char *e;
+    HANDLE th;
+    if (InterlockedCompareExchange(&s_started, 1, 0) != 0) {
+        if (s_started == 1 && s_ready)
+            WaitForSingleObject(s_ready, 3000);
+        return s_started == 2;
+    }
+    e = getenv("RECOMP_SDL_PADS");
+    if (e && *e == '0') {
+        fprintf(stderr, "[PAD] RECOMP_SDL_PADS=0: only XInput controllers\n");
+        InterlockedExchange(&s_started, -1);
+        return 0;
+    }
+    if (!load_sdl()) {
+        fprintf(stderr, "[PAD] SDL2.dll not found next to the exe: only XInput (Xbox) controllers will work\n");
+        xbox_PerfNote("controllers: SDL2.dll missing, only Xbox (XInput) controllers work");
+        InterlockedExchange(&s_started, -1);
+        return 0;
+    }
+    s_ready = CreateEventW(NULL, TRUE, FALSE, NULL);
+    th = CreateThread(NULL, 0, pad_thread, NULL, 0, NULL);
+    if (!th) {
+        InterlockedExchange(&s_started, -1);
+        return 0;
+    }
+    CloseHandle(th);
+    /* Pads present at startup should be there for the title's first poll. */
+    WaitForSingleObject(s_ready, 3000);
+    return s_started == 2;
+}
+
+/* Writes up to max connected, non-ignored pads into out, sorted by
+ * connection order (so the pad that showed up first is always first), and
+ * returns how many. Empty if SDL never came up. */
+int sdlpads_list(SdlPadInfo *out, int max)
+{
+    Pad *sorted[16];
+    int n = 0, i, j;
+    if (s_started != 2)
+        return 0;
+    AcquireSRWLockShared(&s_lock);
+    for (i = 0; i < (int)(sizeof s_pad / sizeof s_pad[0]); i++)
+        if (s_pad[i].used && s_pad[i].c && !s_pad[i].ignored)
+            sorted[n++] = &s_pad[i];
+    for (i = 1; i < n; i++)                  /* by connection order */
+        for (j = i; j > 0 && sorted[j - 1]->order > sorted[j]->order; j--) {
+            Pad *t = sorted[j]; sorted[j] = sorted[j - 1]; sorted[j - 1] = t;
+        }
+    if (n > max)
+        n = max;
+    for (i = 0; i < n; i++)
+        out[i] = sorted[i]->info;
+    ReleaseSRWLockShared(&s_lock);
+    return n;
+}
+
+/* Copies the pad's latest snapshot (as an Xbox pad) into *st; returns 0 if
+ * the id is unknown, ignored, or SDL is not up (caller then treats the pad
+ * as disconnected). */
+int sdlpads_read(int id, XBOX_INPUT_STATE *st)
+{
+    Pad *p;
+    int ok = 0;
+    if (s_started != 2)
+        return 0;
+    AcquireSRWLockShared(&s_lock);
+    p = find(id);
+    if (p && p->c && !p->ignored) {
+        *st = p->st;
+        ok = 1;
+    }
+    ReleaseSRWLockShared(&s_lock);
+    return ok;
+}
+
+/* Records the rumble motor speeds the game wants; update() applies them
+ * (and keeps resending them) on the SDL thread. No-op if the pad is gone. */
+void sdlpads_rumble(int id, unsigned short low, unsigned short high)
+{
+    Pad *p;
+    if (s_started != 2)
+        return;
+    AcquireSRWLockExclusive(&s_lock);
+    p = find(id);
+    if (p) {
+        p->rumble_lo = low;
+        p->rumble_hi = high;
+    }
+    ReleaseSRWLockExclusive(&s_lock);
+}
+
+#endif /* _WIN32 */
diff --git a/src/input/sdl_pads_win.h b/src/input/sdl_pads_win.h
new file mode 100644
index 0000000..a1435e0
--- /dev/null
+++ b/src/input/sdl_pads_win.h
@@ -0,0 +1,37 @@
+/*
+ * sdl_pads_win.h - non-XInput game controllers on Windows, through SDL2.
+ *
+ * XInput only sees Xbox-protocol pads. Switch Pro / 8BitDo (Switch and
+ * D-input modes), PlayStation and generic HID pads need SDL's drivers and
+ * its controller mapping database. SDL2.dll is loaded at run time (next to
+ * the exe); without it this reports nothing and only XInput pads work.
+ *
+ * One thread owns SDL: it initialises it, pumps its events, opens and closes
+ * controllers as they come and go, and publishes a snapshot of each one.
+ * Readers only copy snapshots, so the game's input thread never calls SDL.
+ * Pads SDL reports as Xbox controllers are left to XInput (no doubles).
+ */
+#ifndef SDL_PADS_WIN_H
+#define SDL_PADS_WIN_H
+#if defined(_WIN32)
+#include "xinput_xbox.h"
+
+#define SDLPADS_MAX 8
+
+typedef struct {
+    int  id;                /* SDL instance id: stable while connected */
+    char name[64];
+    char kind[32];          /* "Switch Pro", "PS4", "generic" ... */
+} SdlPadInfo;
+
+/* Starts the SDL thread if RECOMP_SDL_PADS is not 0 and SDL2.dll loads.
+ * Returns 1 when SDL is up. Safe to call more than once. */
+int  sdlpads_start(void);
+/* Connected pads in connection order; returns how many were written. */
+int  sdlpads_list(SdlPadInfo *out, int max);
+/* The pad's current state as an Xbox pad; 0 when it is gone. */
+int  sdlpads_read(int id, XBOX_INPUT_STATE *st);
+void sdlpads_rumble(int id, unsigned short low, unsigned short high);
+
+#endif
+#endif
