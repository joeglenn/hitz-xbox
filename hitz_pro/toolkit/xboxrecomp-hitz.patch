+/* Runs for the presenter's whole life while vsync is on: watches the
+ * window's monitor's real vblanks (IDXGIOutput::WaitForVBlank), estimates
+ * its refresh period from them, and while it is stable and a 60 Hz multiple
+ * reports the lock to xbox_VblankDiscipline (kernel_bridge.c) so the game's
+ * frame clock steers onto it; reports no lock when the display is not a
+ * 60 Hz multiple, is unstable, or RECOMP_PACING=timer. Also feeds
+ * xbox_PerfDisplay for the performance log, about once a second. Raises its
+ * own priority since a late report here directly shows up as judder. */
+static DWORD WINAPI clock_thread(LPVOID unused)
+{
+    IDXGIOutput *out = NULL;
+    uint64_t last = 0;
+    double est = 0;                  /* measured refresh period, ns */
+    int good = 0, fast = 0, odd = 0, locked = 0, every = 0;
+    DWORD next_output = 0, next_report = 0;
+    const int pacing_on = !env_off("RECOMP_PACING");
+    (void)unused;
