+            if ((int)(now_tick - next_report) >= 0) {
+                char d[96];
+                _snprintf_s(d, sizeof d, _TRUNCATE, "%s%s", s_desc,
+                            !locked && hz > 70 && !n ? " (not a 60 Hz multiple: smooth only with G-Sync/FreeSync or the refresh switch)" : "");
+                xbox_PerfDisplay(hz, locked, every, locked ? xbox_VblankLockErrorUs() / 1000.0 : 0.0, d);
+                next_report = now_tick + 1000;
+            }
+        }
