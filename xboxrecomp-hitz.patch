--- a/src/input/xinput_device.c
+++ b/src/input/xinput_device.c
@@ -6,7 +6,7 @@
  * (analog buttons as bytes, separate trigger channels) and the host
  * (digital face buttons, trigger axes).
  *
- *   _WIN32 -> Windows XInput
+ *   _WIN32 -> Windows XInput, plus SDL2 (loaded at run time) for other pads
  *   POSIX  -> SDL2 GameController
  */
 
@@ -50,37 +50,204 @@ static void keyboard_merge(XBOX_INPUT_STATE *pState)
 
 /* ======================================================================== */
 #if defined(_WIN32)
-/* ====================  XInput backend  ================================== */
+/* ============  Windows: XInput + SDL2 (non-Xbox pads)  ================== */
 /* ======================================================================== */
 
+#include <stdio.h>
 #include <xinput.h>
 #pragma comment(lib, "xinput.lib")
+#include "sdl_pads_win.h"
+#include "perf_log.h"
 
-static BOOL  g_controller_connected[XBOX_MAX_CONTROLLERS] = { FALSE };
-static DWORD g_last_packet[XBOX_MAX_CONTROLLERS] = { 0 };
+/* Which host controller plays as each Xbox port.
+ *
+ * It used to be "XInput slot N is port N". That breaks when the first pad
+ * Windows assigns lands in slot 1 (a virtual pad or a driver holding slot 0):
+ * the game then has a player 2 and no player 1. And pads XInput cannot see
+ * (8BitDo in Switch or D-input mode, PlayStation, Switch Pro) never played
+ * at all. Now every connected pad, XInput or SDL, takes the lowest free port
+ * when it arrives and keeps it until it is unplugged, so the first pad is
+ * player 1 whatever it is. Every change is logged with the pad's name. */
+enum { SRC_NONE, SRC_XINPUT, SRC_SDL };
+typedef struct { int kind, id; char name[64]; } PortSrc;
+
+static PortSrc          g_port[XBOX_MAX_CONTROLLERS];
+static BOOL             g_controller_connected[XBOX_MAX_CONTROLLERS];
+static CRITICAL_SECTION g_port_cs;
+static INIT_ONCE        g_port_once = INIT_ONCE_STATIC_INIT;
+
+static BOOL CALLBACK port_init_once(PINIT_ONCE o, PVOID p, PVOID *c)
+{
