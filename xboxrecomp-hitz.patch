diff --git a/src/platform/perf_log.c b/src/platform/perf_log.c
new file mode 100644
index 0000000..6568c5b
--- /dev/null
+++ b/src/platform/perf_log.c
@@ -0,0 +1,405 @@
+/*
+ * perf_log.c - see perf_log.h.
+ */
+#include "perf_log.h"
+
+#ifdef _WIN32
+#include <windows.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "host_time.h"
+
+#define HIST_MAX     8          /* "shown for N refreshes" buckets, N = 1..8 */
+#define RECENT       32         /* frame intervals the hitch rule compares to */
+#define FILES_KEPT   4
+#define HITCH_LINES  20         /* per 5 s summary period; the rest are counted */
+#define SUMMARY_NS   5000000000ull
+
+static CRITICAL_SECTION s_cs;
+static volatile LONG    s_state;            /* 0 unknown, 1 on, -1 off */
+static FILE            *s_f;
+static uint64_t         s_t0;               /* xbox_HostNowNs at init */
+
+/* The game frame in progress. */
+static double   s_cnt[XBOX_PERF_COUNTERS];
+static char     s_files[FILES_KEPT][96];
+static int      s_nfiles, s_files_dropped;
+static uint64_t s_last_flip, s_frames;
+static double   s_recent[RECENT];
+static int      s_nrecent, s_recent_pos;
+
+/* The summary period. */
+static struct {
+    uint64_t start, frames, hitches, hitch_lines, judders, shown[HIST_MAX + 1];
+    double   min_ms, max_ms, shaders, shader_ms, shaders_async, tex, tex_bytes;
+} s_per;
+
+/* Whole run. */
+static uint64_t s_tot_hitches, s_tot_judders;
+static double   s_worst_ms;
+static uint64_t s_worst_frame;
+static int      s_marks;
+
+/* Display, as last reported. */
+static double s_hz, s_phase_ms;
+static int    s_locked, s_every;
+static char   s_presenter[64];
+
+static double secs(uint64_t now) { return (double)(now - s_t0) / 1e9; }
+
+static void stamp(char *b, size_t n, uint64_t now)
+{
+    SYSTEMTIME st;
+    GetLocalTime(&st);
+    _snprintf_s(b, n, _TRUNCATE, "%02u:%02u:%02u t=%8.2fs", st.wHour, st.wMinute,
+                st.wSecond, secs(now));
+}
+
+static void line_locked(uint64_t now, const char *fmt, va_list ap)
+{
+    char ts[48];
+    if (!s_f)
+        return;
+    stamp(ts, sizeof ts, now);
+    fprintf(s_f, "[%s] ", ts);
+    vfprintf(s_f, fmt, ap);
+    fputc('\n', s_f);
+    fflush(s_f);
+}
+
+static void line(uint64_t now, const char *fmt, ...)
+{
+    va_list ap;
+    va_start(ap, fmt);
+    line_locked(now, fmt, ap);
+    va_end(ap);
+}
+
+static void reg_string(HKEY root, const char *key, const char *val, char *out, DWORD n)
+{
+    HKEY h;
+    out[0] = 0;
+    if (RegOpenKeyExA(root, key, 0, KEY_READ, &h) == ERROR_SUCCESS) {
+        DWORD type, sz = n - 1;
+        if (RegQueryValueExA(h, val, NULL, &type, (BYTE *)out, &sz) == ERROR_SUCCESS
+            && type == REG_SZ)
+            out[sz < n ? sz : n - 1] = 0;
+        else
+            out[0] = 0;
+        RegCloseKey(h);
+    }
+}
+
+static void header(void)
+{
+    char cpu[128], prod[128], build[32], exe[MAX_PATH];
+    SYSTEMTIME st;
+    MEMORYSTATUSEX ms;
+    LPCH env;
+
+    GetLocalTime(&st);
+    fprintf(s_f, "==== performance log, %04u-%02u-%02u %02u:%02u:%02u ====\n",
+            st.wYear, st.wMonth, st.wDay, st.wHour, st.wMinute, st.wSecond);
+    if (GetModuleFileNameA(NULL, exe, sizeof exe))
+        fprintf(s_f, "exe:     %s\n", exe);
+    reg_string(HKEY_LOCAL_MACHINE, "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion",
+               "ProductName", prod, sizeof prod);
+    reg_string(HKEY_LOCAL_MACHINE, "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion",
+               "CurrentBuild", build, sizeof build);
+    fprintf(s_f, "windows: %s (build %s)\n", prod[0] ? prod : "?", build[0] ? build : "?");
+    reg_string(HKEY_LOCAL_MACHINE, "HARDWARE\\DESCRIPTION\\System\\CentralProcessor\\0",
+               "ProcessorNameString", cpu, sizeof cpu);
+    fprintf(s_f, "cpu:     %s (%lu logical)\n", cpu[0] ? cpu : "?",
+            (unsigned long)GetActiveProcessorCount(ALL_PROCESSOR_GROUPS));
+    ms.dwLength = sizeof ms;
+    if (GlobalMemoryStatusEx(&ms))
+        fprintf(s_f, "memory:  %.1f GB\n", (double)ms.ullTotalPhys / (1024.0 * 1024.0 * 1024.0));
+    fprintf(s_f, "settings:");
+    env = GetEnvironmentStringsA();
+    if (env) {
+        const char *p;
+        int any = 0;
+        for (p = env; *p; p += strlen(p) + 1)
+            if (!strncmp(p, "RECOMP_", 7) || !strncmp(p, "HITZ_", 5)) {
+                fprintf(s_f, "%s %s", any ? "," : "", p);
+                any = 1;
+            }
+        if (!any)
+            fprintf(s_f, " (none)");
+        FreeEnvironmentStringsA(env);
+    }
+    fprintf(s_f, "\n");
+    fprintf(s_f, "How to read: HITCH = a game frame that took much longer than the ones\n"
+                 "around it (and what happened during it); JUDDER = a frame stayed on screen\n"
+                 "longer or shorter than the steady cadence; MARK = F9 pressed. Times are\n"
+                 "wall clock and seconds since start.\n\n");
+    fflush(s_f);
+}
+
+void xbox_PerfInit(void)
+{
+    const char *e, *name;
+    if (InterlockedCompareExchange(&s_state, -1, 0) != 0)
+        return;                                 /* already decided */
+    e = getenv("RECOMP_PERF_LOG");
+    if (!e || !*e || *e == '0')
+        return;                                 /* stays -1: off */
+    name = getenv("RECOMP_PERF_LOG_FILE");
+    if (!name || !*name)
+        name = "perf.log";
+    if (fopen_s(&s_f, name, "w") != 0 || !s_f) {
+        fprintf(stderr, "[PERF] cannot write %s; no performance log\n", name);
+        return;
+    }
+    InitializeCriticalSection(&s_cs);
+    s_t0 = xbox_HostNowNs();
+    s_per.start = s_t0;
+    s_per.min_ms = 1e9;
+    header();
+    fprintf(stderr, "[PERF] performance log: %s (F9 adds a mark)\n", name);
+    InterlockedExchange(&s_state, 1);
+}
+
+int xbox_PerfEnabled(void)
+{
+    if (s_state == 0)
+        xbox_PerfInit();
+    return s_state > 0;
+}
+
+void xbox_PerfNote(const char *fmt, ...)
+{
+    va_list ap;
+    if (!xbox_PerfEnabled())
+        return;
+    EnterCriticalSection(&s_cs);
+    va_start(ap, fmt);
+    line_locked(xbox_HostNowNs(), fmt, ap);
+    va_end(ap);
+    LeaveCriticalSection(&s_cs);
+}
+
+void xbox_PerfCount(int counter, double amount)
+{
+    if (counter < 0 || counter >= XBOX_PERF_COUNTERS || !xbox_PerfEnabled())
+        return;
+    EnterCriticalSection(&s_cs);
+    s_cnt[counter] += amount;
+    LeaveCriticalSection(&s_cs);
+}
+
+void xbox_PerfFile(const char *path)
+{
+    const char *p;
+    if (!path || !xbox_PerfEnabled())
+        return;
+    p = path + strlen(path);                     /* keep the tail of long paths */
+    if (p - path > 90)
+        path = p - 90;
+    EnterCriticalSection(&s_cs);
+    if (s_nfiles < FILES_KEPT)
+        strncpy_s(s_files[s_nfiles++], sizeof s_files[0], path, _TRUNCATE);
+    else
+        s_files_dropped++;
+    LeaveCriticalSection(&s_cs);
+}
+
+static double median_recent(void)
+{
+    double v[RECENT];
+    int n = s_nrecent, i, j;
+    for (i = 0; i < n; i++)
+        v[i] = s_recent[i];
+    for (i = 1; i < n; i++) {                   /* n <= 32: insertion sort */
+        double x = v[i];
+        for (j = i - 1; j >= 0 && v[j] > x; j--)
+            v[j + 1] = v[j];
+        v[j + 1] = x;
+    }
+    return n ? v[n / 2] : 0.0;
+}
+
+static void summary_locked(uint64_t now)
+{
+    double sec = (double)(now - s_per.start) / 1e9;
+    char hist[96] = "", lock[48];
+    int i, o = 0;
+    if (!s_locked)
+        _snprintf_s(lock, sizeof lock, _TRUNCATE, "free-running");
+    else if (s_every > 1)
+        _snprintf_s(lock, sizeof lock, _TRUNCATE, "locked, every %d refreshes, phase %+.1f ms",
+                    s_every, s_phase_ms);
+    else
+        _snprintf_s(lock, sizeof lock, _TRUNCATE, "locked, phase %+.1f ms", s_phase_ms);
+    for (i = 1; i <= HIST_MAX; i++)
+        if (s_per.shown[i])
+            o += _snprintf_s(hist + o, sizeof hist - o, _TRUNCATE, "%s%dx:%llu",
+                             o ? " " : "", i, (unsigned long long)s_per.shown[i]);
+    line(now, "%5.1f fps | frame %.1f-%.1f ms | hitches %llu | display %.2f Hz %s | "
+              "shown %s | shaders %.0f (%.0f ms)%s | textures %.0f (%.1f MB)",
+         sec > 0 ? (double)s_per.frames / sec : 0.0,
+         s_per.frames ? s_per.min_ms : 0.0, s_per.frames ? s_per.max_ms : 0.0,
+         (unsigned long long)s_per.hitches, s_hz, lock,
+         o ? hist : "-", s_per.shaders, s_per.shader_ms,
+         s_per.shaders_async > 0 ? " +bg" : "", s_per.tex, s_per.tex_bytes / 1048576.0);
+    if (s_per.hitch_lines > HITCH_LINES)
+        line(now, "  (%llu more hitches in this period not listed)",
+             (unsigned long long)(s_per.hitch_lines - HITCH_LINES));
+    memset(&s_per, 0, sizeof s_per);
+    s_per.start = now;
+    s_per.min_ms = 1e9;
+}
+
+void xbox_PerfFlip(void)
+{
+    uint64_t now;
+    double ms;
+    if (!xbox_PerfEnabled())
+        return;
+    now = xbox_HostNowNs();
+    EnterCriticalSection(&s_cs);
+    if (s_last_flip) {
+        ms = (double)(now - s_last_flip) / 1e6;
+        s_frames++;
+        s_per.frames++;
+        if (ms < s_per.min_ms) s_per.min_ms = ms;
+        if (ms > s_per.max_ms) s_per.max_ms = ms;
+        s_per.shaders += s_cnt[XBOX_PERF_SHADERS];
+        s_per.shader_ms += s_cnt[XBOX_PERF_SHADER_MS];
+        s_per.shaders_async += s_cnt[XBOX_PERF_SHADERS_ASYNC];
+        s_per.tex += s_cnt[XBOX_PERF_TEXTURES];
+        s_per.tex_bytes += s_cnt[XBOX_PERF_TEX_BYTES];
+        /* A hitch: clearly longer than the recent steady cadence (so a menu
+         * that runs at 30 fps on purpose is not a hitch every frame), and
+         * longer than a 60 Hz frame and a half in any case. */
+        if (s_nrecent >= 8) {
+            double med = median_recent();
+            if (ms > 25.0 && ms > med * 1.5) {
+                s_per.hitches++;
+                s_tot_hitches++;
+                if (++s_per.hitch_lines <= HITCH_LINES) {
+                    char files[FILES_KEPT * 100 + 32] = "";
+                    int i, o = 0;
+                    for (i = 0; i < s_nfiles; i++)
+                        o += _snprintf_s(files + o, sizeof files - o, _TRUNCATE, "%s%s",
+                                         i ? ", " : "", s_files[i]);
+                    if (s_files_dropped)
+                        _snprintf_s(files + o, sizeof files - o, _TRUNCATE, " +%d more",
+                                    s_files_dropped);
+                    line(now, "HITCH frame %llu took %.1f ms (usual %.1f) | shaders %.0f (%.1f ms) "
+                              "| textures %.0f (%.1f MB)%s%s",
+                         (unsigned long long)s_frames, ms, med, s_cnt[XBOX_PERF_SHADERS],
+                         s_cnt[XBOX_PERF_SHADER_MS], s_cnt[XBOX_PERF_TEXTURES],
+                         s_cnt[XBOX_PERF_TEX_BYTES] / 1048576.0,
+                         s_nfiles ? " | files: " : "", files);
+                }
+                if (ms > s_worst_ms) {
+                    s_worst_ms = ms;
+                    s_worst_frame = s_frames;
+                }
+            }
+        }
+        s_recent[s_recent_pos] = ms;
+        s_recent_pos = (s_recent_pos + 1) % RECENT;
+        if (s_nrecent < RECENT)
+            s_nrecent++;
+    }
+    s_last_flip = now;
+    memset(s_cnt, 0, sizeof s_cnt);
+    s_nfiles = s_files_dropped = 0;
+    if (now - s_per.start >= SUMMARY_NS)
+        summary_locked(now);
+    LeaveCriticalSection(&s_cs);
+}
+
+void xbox_PerfShown(uint32_t refreshes, uint32_t expected)
+{
+    if (!xbox_PerfEnabled() || !refreshes)
+        return;
+    EnterCriticalSection(&s_cs);
+    s_per.shown[refreshes > HIST_MAX ? HIST_MAX : refreshes]++;
+    if (expected && refreshes != expected) {
+        s_per.judders++;
+        s_tot_judders++;
+        if (s_per.judders <= 5)
+            line(xbox_HostNowNs(), "JUDDER a frame stayed on screen for %u refresh%s (steady: %u)",
+                 refreshes, refreshes == 1 ? "" : "es", expected);
+    }
+    LeaveCriticalSection(&s_cs);
+}
+
+void xbox_PerfDisplay(double hz, int locked, int every, double phase_err_ms,
+                      const char *presenter)
+{
+    if (!xbox_PerfEnabled())
+        return;
+    EnterCriticalSection(&s_cs);
+    if ((locked != s_locked || every != s_every || (s_hz > 0 && (hz - s_hz > 1.0 || s_hz - hz > 1.0))
+         || (presenter && strcmp(presenter, s_presenter)))
+        && hz > 0)
+        line(xbox_HostNowNs(), "display: %.2f Hz, %s%s%s", hz,
+             locked ? "game frames locked to the display" : "game frames on their own timer",
+             presenter ? ", " : "", presenter ? presenter : "");
+    s_hz = hz;
+    s_locked = locked;
+    s_every = every;
+    s_phase_ms = phase_err_ms;
+    if (presenter)
+        strncpy_s(s_presenter, sizeof s_presenter, presenter, _TRUNCATE);
+    LeaveCriticalSection(&s_cs);
+}
+
+int xbox_PerfMark(void)
+{
+    int n;
+    double med;
+    if (!xbox_PerfEnabled())
+        return 0;
+    EnterCriticalSection(&s_cs);
+    n = ++s_marks;
+    med = median_recent();
+    line(xbox_HostNowNs(), "*** MARK %d (F9) *** recent frames: usual %.1f ms, this period so far: "
+                           "%llu frames, %llu hitches, worst %.1f ms",
+         n, med, (unsigned long long)s_per.frames, (unsigned long long)s_per.hitches,
+         s_per.frames ? s_per.max_ms : 0.0);
+    LeaveCriticalSection(&s_cs);
+    return n;
+}
+
+void xbox_PerfShutdown(const char *why)
+{
+    if (s_state <= 0)
+        return;
+    EnterCriticalSection(&s_cs);
+    if (s_f) {
+        uint64_t now = xbox_HostNowNs();
+        summary_locked(now);
+        line(now, "end (%s): %llu frames, %llu hitches (worst %.1f ms at frame %llu), "
+                  "%llu judders, %d marks",
+             why ? why : "exit", (unsigned long long)s_frames,
+             (unsigned long long)s_tot_hitches, s_worst_ms,
+             (unsigned long long)s_worst_frame, (unsigned long long)s_tot_judders, s_marks);
+        fclose(s_f);
+        s_f = NULL;
+    }
+    InterlockedExchange(&s_state, -1);
+    LeaveCriticalSection(&s_cs);
+}
+
+#else /* !_WIN32: the log is Windows-only for now */
+
+void xbox_PerfInit(void) {}
+int  xbox_PerfEnabled(void) { return 0; }
+void xbox_PerfNote(const char *fmt, ...) { (void)fmt; }
+void xbox_PerfCount(int counter, double amount) { (void)counter; (void)amount; }
+void xbox_PerfFile(const char *path) { (void)path; }
+void xbox_PerfFlip(void) {}
+void xbox_PerfShown(uint32_t refreshes, uint32_t expected) { (void)refreshes; (void)expected; }
+void xbox_PerfDisplay(double hz, int locked, int every, double phase_err_ms, const char *presenter)
+{ (void)hz; (void)locked; (void)every; (void)phase_err_ms; (void)presenter; }
+int  xbox_PerfMark(void) { return 0; }
+void xbox_PerfShutdown(const char *why) { (void)why; }
+
+#endif
diff --git a/src/platform/perf_log.h b/src/platform/perf_log.h
new file mode 100644
index 0000000..4e56aef
--- /dev/null
+++ b/src/platform/perf_log.h
@@ -0,0 +1,67 @@
+/*
+ * perf_log.h - a human-readable timing log for chasing stutter.
+ *
+ * One file (RECOMP_PERF_LOG_FILE, default "perf.log" in the working
+ * directory), written only when RECOMP_PERF_LOG=1. It answers "why did that
+ * moment feel laggy" after the fact:
+ *
+ *   - a header with the machine, the display and the settings in effect;
+ *   - a HITCH line for every game frame that took clearly longer than the
+ *     ones around it, with what happened during it (shaders compiled,
+ *     textures uploaded, game files opened);
+ *   - a JUDDER line when the presenter saw a frame stay on screen for a
+ *     different number of display refreshes than the steady cadence;
+ *   - a summary every 5 s (frame rate, frame-time range, display rate and
+ *     pacing state);
+ *   - a MARK line each time the player presses F9, so "it stuttered just
+ *     now" can be found in the file by its wall-clock time.
+ *
+ * Every call is cheap and thread-safe; all of them do nothing while the log
+ * is off. Each line is flushed as it is written, so a crash keeps the tail.
+ */
+#ifndef XBOX_PERF_LOG_H
+#define XBOX_PERF_LOG_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Per-frame counters, reset at each game frame (xbox_PerfFlip). */
+enum {
+    XBOX_PERF_SHADERS = 0,      /* shaders compiled on the render thread */
+    XBOX_PERF_SHADER_MS,        /* ... and the milliseconds that took */
+    XBOX_PERF_SHADERS_ASYNC,    /* shaders handed to the background compiler */
+    XBOX_PERF_TEXTURES,         /* textures uploaded */
+    XBOX_PERF_TEX_BYTES,        /* ... and their size */
+    XBOX_PERF_COUNTERS
+};
+
+void xbox_PerfInit(void);
+int  xbox_PerfEnabled(void);
+/* A free-form line, prefixed with the time. */
+void xbox_PerfNote(const char *fmt, ...);
+void xbox_PerfCount(int counter, double amount);
+/* A game file was opened (shown on a hitch that happened during it). */
+void xbox_PerfFile(const char *path);
+/* The title flipped: one game frame ended. */
+void xbox_PerfFlip(void);
+/* The presenter's view: the previous frame stayed on screen for `refreshes`
+ * display refreshes; `expected` is the steady value (0 when there is none,
+ * e.g. a 144 Hz display showing 60 fps). */
+void xbox_PerfShown(uint32_t refreshes, uint32_t expected);
+/* Display state, for the summaries: refresh rate, whether the game's frame
+ * clock is locked to it (and every how many refreshes), the lock's phase
+ * error, and a short description of the presenter. */
+void xbox_PerfDisplay(double hz, int locked, int every, double phase_err_ms,
+                      const char *presenter);
+/* F9: returns the mark's number (shown in the window title), 0 when off. */
+int  xbox_PerfMark(void);
+void xbox_PerfShutdown(const char *why);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/src/usb/ohci.c b/src/usb/ohci.c
index efa5046..16f2a17 100644
--- a/src/usb/ohci.c
+++ b/src/usb/ohci.c
@@ -511,23 +511,50 @@ static int guest_ok(uint32_t va, uint32_t bytes)
  * again, forever. */
 static uint32_t bus_resolve(uint32_t addr)
 {
-    if (addr >= g_xbox_image_lo && addr < g_xbox_image_hi)
-        return addr;
+    if (addr >= g_xbox_image_lo && addr < g_xbox_image_hi) {
+        /* An image static only if the title named it as one, or no live
+         * window block covers the page (see bus_resolve_desc). */
+        extern int xbox_PhysImageNamed(uint32_t);
+        extern const volatile uint8_t *xbox_ContiguousPageMap(void);
+        const volatile uint8_t *map = xbox_ContiguousPageMap();
+        if (xbox_PhysImageNamed(addr) || !map || addr >= OHCI_CONTIG_SIZE
+                || map[addr >> 12] != 1)
+            return addr;
+        return OHCI_CONTIG_BASE + addr;
+    }
     if (addr && addr < xbox_ContiguousAllocatedBytes())
         return OHCI_CONTIG_BASE + addr;
     return addr;
 }
 
+/* Descriptor pointers (HCCA, ED and TD links) are always DMA memory: XAPI
+ * builds them in MmAllocateContiguousMemory. This runtime's contiguous
+ * allocator hands out physical numbers from 0x1000 up, so with a large XBE
+ * those numbers fall inside the image range, and bus_resolve's image-first
+ * rule read NHL Hitz Pro's control ED (physical 0x004024C0, window block
+ * 0x80402000) out of .data as zeroes -- enumeration then stalled after the
+ * port reset. A page that is currently allocated in the window is the
+ * window. Data buffers keep bus_resolve: they can be image statics
+ * (Burnout 3). */
+extern const volatile uint8_t *xbox_ContiguousPageMap(void);
